# The vulnerability scanners CI runs. Shell-sourceable KEY=value, no expansions. As in
# packaging/versions.env, the checksum is the pin: bump a version and its checksum together, from the
# release's own checksum file. scripts/vuln-tools.sh downloads them; only linux/amd64 runs them.
OSV_SCANNER_VERSION=2.6.0
OSV_SCANNER_LINUX_AMD64_SHA256=ca69b3d3cd08f889a49dc0a383122f71cc528b83803671df5fd874d97485b108
TRIVY_VERSION=0.75.0
TRIVY_LINUX_AMD64_SHA256=c6e65abddb348e25f10549df887045629cf28cc72453cd1c63acb717316b3f3f

# A Go module version: go install checks it against the checksum database, with the pinned Go
# (packaging/shared/connector/vulncheck.sh).
GOVULNCHECK_VERSION=v1.9.0
