# Copy to services/node/.env.dev, which `pnpm dev` loads.

# Docker: `pnpm db:up`. macOS without Docker: `packaging/macos/dev/postgres.sh start` prints the socket URL to use here.
DATABASE_URL=postgres://stuga:stuga@127.0.0.1:55433/stuga

# Relative to services/node; never shared between two nodes.
DATA_DIR=../../data/dev-node

# Off 8787, so a packaged node can run beside it.
PORT=8788

# Vite serves the SPA on :3001 and proxies the rest here.
PUBLIC_ORIGIN=http://localhost:3001
