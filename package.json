{
  "name": "stuga",
  "version": "0.0.1",
  "private": true,
  "description": "Stuga — the self-hosted collaborative workspace built for humans and AI agents",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint . --deny-warnings",
    "test": "turbo run test",
    "test:integration": "bash scripts/test-integration.sh",
    "test:drill": "bash packaging/docker/test/restore-drill.sh",
    "dev": "STUGA_NODE=http://127.0.0.1:8788 turbo run dev",
    "dev:web": "pnpm --filter @stuga/web dev",
    "db:up": "docker compose -f packaging/docker/dev/compose.postgres.yml up -d --wait",
    "db:down": "docker compose -f packaging/docker/dev/compose.postgres.yml down",
    "db:reset": "docker compose -f packaging/docker/dev/compose.postgres.yml down -v && pnpm db:up",
    "check:packaged": "STUGA_VOLUME_NAME=stuga_check_pgdata docker compose -p stuga-check -f packaging/docker/compose.yml -f packaging/docker/compose.build.yml up -d --build",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "~22.20.4",
    "oxlint": "^1.85.0",
    "postgres": "^3.4.9",
    "turbo": "^2.11.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "~22.20.4",
      "@tiptap/core": "3.31.3",
      "@tiptap/pm": "3.31.3",
      "@tiptap/react": "3.31.3",
      "@tiptap/starter-kit": "3.31.3",
      "@tiptap/extension-collaboration": "3.31.3",
      "@tiptap/extension-collaboration-caret": "3.31.3",
      "@tiptap/extension-link": "3.31.3",
      "@tiptap/extension-code": "3.31.3",
      "@tiptap/extension-code-block": "3.31.3",
      "@tiptap/extension-image": "3.31.3",
      "@tiptap/extension-table": "3.31.3",
      "@tiptap/extension-table-cell": "3.31.3",
      "@tiptap/extension-table-header": "3.31.3",
      "@tiptap/extension-table-row": "3.31.3",
      "@tiptap/y-tiptap": "3.0.9",
      "lodash-es@<4.18.1": "^4.18.1"
    }
  }
}
