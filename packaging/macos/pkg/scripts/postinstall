#!/bin/bash
# After a Stuga package installs its runtime: the _stuga and _stugaremote accounts, the directories,
# `current`, the four jobs, the database cluster once, and a start. Before the jobs it opens the
# menu-bar app for whoever is at the Mac, which opens the setup page once Stuga serves, until someone
# has set it up; an upgrade starts the new version, which backs up the data before it changes
# anything. Each job is enabled before it starts, since a go-back that stopped short leaves the node
# disabled; while bin/stuga holds status/restoring, the node's wrapper does not start it.
# build-pkg.sh fills in the version.
set -euo pipefail

# preinstall's mark that Stuga is stopped on purpose goes however this ends: Stuga runs again, or
# the menu-bar app should say that it does not.
trap 'rm -f "/Library/Application Support/Stuga/status/installing"' EXIT

main() {
  local version="@VERSION@" port=8787
  local root="/Library/Application Support/Stuga" logs="/Library/Logs/Stuga"
  local runtime="$root/runtime/$version"
  [ -x "$runtime/node/bin/node" ] || { echo "error: the package left no runtime at $runtime" >&2; exit 1; }

  ensure_account _stuga "Stuga"
  # The connector's own account, in neither group: _stuga's reaches data/ and Postgres's socket, and a
  # new file takes its directory's group.
  ensure_account _stugaremote "Stuga remote access"

  install -d -o root -g wheel -m 0755 "$root" "$root/runtime" "$root/status"
  install -d -o _stuga -g _stuga -m 0750 "$root/data"
  install -d -o _stuga -g _stuga -m 0700 "$root/data/node"
  # The node drops upgrade and connector requests here; only root, which runs the helper, reads them.
  install -d -o root -g _stuga -m 0770 "$root/requests"
  # Shared by the node and the connector: made here, since one the node made would be wheel's.
  install -d -o _stuga -g _stugaremote -m 0750 "$root/remote"
  # The connector, installed by the helper: only _stugaremote can run it, and neither account can
  # change it.
  install -d -o root -g _stugaremote -m 0750 "$root/connector"
  # The setup code, until someone sets Stuga up: the node writes it, the Mac's administrators read it.
  install -d -o _stuga -g admin -m 0750 "$root/setup"
  # Where 0.1.7 kept it, which only _stuga could read. The copy takes setup/'s group.
  if [ -f "$root/data/node/setup-code" ]; then
    # shellcheck disable=SC2016 # sh's own $1 and $2
    as_stuga /bin/sh -c 'cp "$1" "$2" && chmod 0640 "$2" && rm -f "$1"' sh \
      "$root/data/node/setup-code" "$root/setup/setup-code" || true
  fi
  # Passable, not listable: _stugaremote reaches its own logs and cannot write _stuga's.
  install -d -o _stuga -g admin -m 0751 "$logs"
  install -d -o _stugaremote -g admin -m 0750 "$logs/remote"
  ln -sfn "runtime/$version" "$root/current"

  # The address: kept from an earlier install, else this Mac's local name. Only a success is one:
  # macOS 15's plutil writes a missing key's error to stdout.
  local origin
  origin="$(plutil -extract EnvironmentVariables.PUBLIC_ORIGIN raw /Library/LaunchDaemons/dev.stuga.node.plist 2> /dev/null)" ||
    origin=""
  [ -n "$origin" ] || origin="http://$(scutil --get LocalHostName | tr '[:upper:]' '[:lower:]').local:$port"
  open_app
  local remote_plist=/Library/LaunchDaemons/dev.stuga.remote.plist first_remote=no
  [ -f "$remote_plist" ] || first_remote=yes
  STUGA_LAUNCHD_TEMPLATES="$runtime/share/launchd/templates" bash "$runtime/share/launchd/render-launchd.sh" \
    --mode daemon --out /Library/LaunchDaemons --public-origin "$origin" --bind 0.0.0.0 --port "$port" \
    --extra-origins "http://127.0.0.1:$port" --keep-env > /dev/null
  chown root:wheel /Library/LaunchDaemons/dev.stuga.*.plist
  chmod 0644 /Library/LaunchDaemons/dev.stuga.*.plist
  # Off until an administrator turns remote access on. An upgrade leaves the job as it is: the helper
  # restarts it once for the new connector, and the new plist takes effect then.
  if [ "$first_remote" = yes ]; then launchctl disable system/dev.stuga.remote; fi

  if [ ! -f "$root/data/pgdata/PG_VERSION" ]; then
    bash "$runtime/bin/init-cluster.sh" --pgbin "$runtime/postgres/bin" --data "$root/data/pgdata" \
      --socket "$root/data/run" --os-user _stuga
  fi
  # The live halves are copied mid-write; Time Machine keeps backups/, which the node fills daily.
  # shellcheck source=../../runtime/bin/timemachine.sh
  . "$runtime/bin/timemachine.sh"
  as_stuga /usr/bin/xattr -wx "$TM_EXCLUDE_ATTR" "$TM_EXCLUDE_VALUE" "$root/data/pgdata" "$root/data/node" \
    > /dev/null 2>&1 || true

  local label
  for label in dev.stuga.postgres dev.stuga.node; do
    launchctl bootout "system/$label" > /dev/null 2>&1 || true
    launchctl enable "system/$label"
    launchctl bootstrap system "/Library/LaunchDaemons/$label.plist"
  done
  rm -f "$root/status/installing"
  # Never reloaded here: an upgrade the helper started is running inside it.
  launchctl print system/dev.stuga.helper > /dev/null 2>&1 ||
    launchctl bootstrap system /Library/LaunchDaemons/dev.stuga.helper.plist

  prune_runtimes "$root" "$version"
}

# as_stuga <program> [arguments…]: as _stuga, for paths _stuga can change, so root follows no link
# it put there.
as_stuga() { (cd / && exec sudo -u _stuga "$@"); }

# ensure_account <name> <real name>: a user and a group of that name, hidden, with no shell and no
# home, at an unused id. The group is the user's only one.
ensure_account() {
  local name="$1" real="$2" id
  if dscl . -read "/Groups/$name" > /dev/null 2>&1 && dscl . -read "/Users/$name" > /dev/null 2>&1; then return; fi
  id="$(free_id "$name")"
  if ! dscl . -read "/Groups/$name" > /dev/null 2>&1; then
    # A user left without its group, by an uninstall cut short: the group gets its old id back when free.
    local was=""
    if dscl . -read "/Users/$name" > /dev/null 2>&1; then
      was="$(dscl . -read "/Users/$name" PrimaryGroupID | awk '{print $2}')"
    fi
    case "$was" in
      '' | *[!0-9]*) ;;
      *) dscl . -list /Groups PrimaryGroupID | awk '{print $2}' | grep -qx "$was" || id="$was" ;;
    esac
    dscl . -create "/Groups/$name"
    dscl . -create "/Groups/$name" PrimaryGroupID "$id"
    dscl . -create "/Groups/$name" RealName "$real"
    dscl . -create "/Groups/$name" Password '*'
  fi
  if ! dscl . -read "/Users/$name" > /dev/null 2>&1; then
    dscl . -create "/Users/$name"
    dscl . -create "/Users/$name" UniqueID "$id"
    dscl . -create "/Users/$name" PrimaryGroupID "$(dscl . -read "/Groups/$name" PrimaryGroupID | awk '{print $2}')"
    dscl . -create "/Users/$name" UserShell /usr/bin/false
    dscl . -create "/Users/$name" NFSHomeDirectory /var/empty
    dscl . -create "/Users/$name" RealName "$real"
    dscl . -create "/Users/$name" Password '*'
    dscl . -create "/Users/$name" IsHidden 1
  fi
}

# free_id <name>: an id from 250 to 400 that no user and no group has, the ones just created included.
free_id() {
  local used id
  used="$( (dscl . -list /Users UniqueID; dscl . -list /Groups PrimaryGroupID) | awk '{print $2}')"
  for id in $(seq 250 400); do
    printf '%s\n' "$used" | grep -qx "$id" || { printf '%s' "$id"; return; }
  done
  echo "error: no free id from 250 to 400 for $1" >&2
  exit 1
}

# prune_runtimes <root> <version>: keep only this runtime. Going back is the older release's package
# and the backup taken before the upgrade, not a runtime kept here. Each package prunes in its own
# postinstall, so a release that still needs the one it replaces keeps it there.
prune_runtimes() {
  local dir
  for dir in "$1"/runtime/*; do
    [ "$(basename "$dir")" = "$2" ] || rm -rf "$dir"
  done
}

# For whoever is at the Mac: the menu-bar app, and a few seconds for Login Items to learn of it. It
# files a job under the app its AssociatedBundleIdentifiers names only if the app has run by the time
# it first sees the job, and under the developer otherwise, for good. Nothing waits for Stuga.
# The wait is by the clock: one sfltool dumpbtm takes seconds.
open_app() {
  local user uid deadline=$((SECONDS + 10))
  user="$(stat -f %Su /dev/console 2> /dev/null || true)"
  uid="$(stat -f %u /dev/console 2> /dev/null || true)"
  [ -n "$uid" ] && [ "$user" != root ] || return 0
  launchctl asuser "$uid" sudo -u "$user" open -a /Applications/Stuga.app > /dev/null 2>&1 || return 0
  while [ "$SECONDS" -lt "$deadline" ]; do
    case "$(sfltool dumpbtm 2> /dev/null)" in *"Identifier: 2.dev.stuga.app"*) return 0 ;; esac
    sleep 1
  done
}

main "$@"
