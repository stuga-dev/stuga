#!/bin/bash
# Before a Stuga package installs: stop the node and its Postgres, so the new runtime starts clean.
# The helper is left alone: it may be the job running this installer.
set -euo pipefail

main() {
  local label i
  for label in dev.stuga.node dev.stuga.postgres; do
    launchctl print "system/$label" > /dev/null 2>&1 || continue
    launchctl bootout "system/$label" || true
    # The node closes its documents first, and Postgres waits for it: up to a minute each.
    for i in $(seq 1 120); do
      launchctl print "system/$label" > /dev/null 2>&1 || break
      sleep 1
    done
  done
}

main "$@"
