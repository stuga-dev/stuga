#!/bin/bash
# Before a Stuga package installs: stop the node and its Postgres, so the new runtime starts clean.
# The helper is left alone: it may be the job running this installer.
#
# First it marks Stuga as stopped on purpose (status/installing), so the menu-bar app does not
# report it; postinstall clears the mark once Stuga runs again. Stopping short here ends the install,
# so the mark goes too. The app ignores a mark older than half an hour, which an install that stopped
# between the two scripts leaves.
set -euo pipefail

# Not local: the EXIT trap runs after main has returned. It cannot go by the exit status, which a
# signal leaves at 0.
mark="" finished=no
unmark_unless_finished() {
  [ "$finished" = yes ] || [ -z "$mark" ] || rm -f "$mark"
}
trap unmark_unless_finished EXIT

main() {
  local root="${STUGA_ROOT:-/Library/Application Support/Stuga}" label
  # A cluster a 0.1 release set up loads pg_search, which later releases do not carry, and its schema
  # started again at 0.2.0: their Postgres would not start on it. Stopped before anything, 0.1 runs on.
  if grep -qs "^shared_preload_libraries.*pg_search" "$root/data/pgdata/postgresql.conf"; then
    echo "error: this Mac holds data from Stuga 0.1, a preview; later releases start with new data. Nothing was changed, and Stuga 0.1 still runs." >&2
    echo "To move to this release, export each workspace first: see From Stuga 0.1 in docs/install/macos.md." >&2
    exit 1
  fi
  # A first install has nothing running to mark.
  if [ -d "$root" ]; then
    install -d -m 0755 "$root/status"
    mark="$root/status/installing"
    touch "$mark"
  fi
  for label in dev.stuga.node dev.stuga.postgres; do
    launchctl print "system/$label" > /dev/null 2>&1 || continue
    launchctl bootout "system/$label" || true
    # The node closes its documents first, and Postgres waits for it: up to a minute each.
    for _ in $(seq 1 120); do
      launchctl print "system/$label" > /dev/null 2>&1 || break
      sleep 1
    done
  done
  finished=yes
}

main "$@"
