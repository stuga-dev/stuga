<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The remote access connector, as _stugaremote: remote-wrapper.sh checks each relay's settings the
  node wrote, then runs one frpc per relay. Rendered by packaging/macos/build/render-launchd.sh in
  daemon mode only.

  - Installed disabled. The upgrade helper enables, starts and stops it as the node asks
    (requests/remote), and restarts it only when the connector or its settings change.
  - Only _stugaremote and root can run the connector: the node, as _stuga, can neither run it nor
    hand it settings the wrapper has not checked.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@LABEL@</string>

  <key>AssociatedBundleIdentifiers</key>
  <string>@BUNDLE_ID@</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@ROOT@/current/bin/remote-wrapper.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>STUGA_ROOT</key>
    <string>@ROOT@</string>
    <key>STUGA_LOG_DIR</key>
    <string>@LOGS@/remote</string>
  </dict>

  <key>UserName</key>
  <string>_stugaremote</string>
  <key>GroupName</key>
  <string>_stugaremote</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>WorkingDirectory</key>
  <string>/var/empty</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ExitTimeOut</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Standard</string>

  <key>StandardOutPath</key>
  <string>@LOGS@/remote/remote-wrapper.log</string>
  <key>StandardErrorPath</key>
  <string>@LOGS@/remote/remote-wrapper.log</string>
</dict>
</plist>
