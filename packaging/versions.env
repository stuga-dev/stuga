# Every pinned input of both packagings. Shell-sourceable KEY=value, no expansions.
# A version in a download URL is not a pin: bump a version and its checksums together.
# packaging/check-pins.sh fails when a Dockerfile default, .nvmrc or package.json disagrees.

NODE_VERSION=26.12.1
NODE_DARWIN_ARM64_SHA256=1901d539912c02afa10d1cc126943a8855a7eedebe830119463470db5e6c59e8
PNPM_VERSION=12.14.0

PG_MAJOR=18
PGVECTOR_VERSION=0.8.6

# Postgres.app's DMG for PG_MAJOR; its PostgreSQL patch level and pgvector come with it.
POSTGRES_APP_VERSION=2.9.6
POSTGRES_APP_DMG_SHA256=9fc7d0dc08cf46dfd94bb32cbaaad81b41b37847a42d6dcb2f9fbd292813defb

# The Debian line of the Docker images.
DEBIAN_SUITE=trixie
PGDG_KEY_SHA256=0144068502a1eddd2a0280ede10ef607d1ec592ce819940991203941564e8e76

# One cluster spec on both platforms; the node refuses a database with another collation.
INITDB_ARGS="--encoding=UTF8 --locale-provider=builtin --builtin-locale=C.UTF-8 --locale=C.UTF-8 --data-checksums"

# The remote-access connector: frpc built from this commit of frp's tag with this Go, and its
# license notices generated by go-licenses (packaging/shared/connector/build.sh). A Go security
# release is a reason to bump GO_VERSION. Each target builds with its own platform's Go: darwin-arm64
# for the Mac's download, linux-amd64 and linux-arm64 in the stuga-remote image.
FRP_VERSION=0.71.1
FRP_COMMIT=d8cf1800dc1abd7fda1828cab105d7a6b5a50eb1
GO_VERSION=1.27.3
GO_DARWIN_ARM64_SHA256=dd3908cf20959d798c1e06ebe5b72213f0505ce01373b40ce3110975a6cd99c2
GO_LINUX_AMD64_SHA256=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
GO_LINUX_ARM64_SHA256=a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49
GO_LICENSES_VERSION=v2.0.1
